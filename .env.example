# Copy this file to .env for local development.
# Never commit a real API key.

# =============================================================================
# Recommended: DeepSeek v4 Pro through ModelGateway
# =============================================================================

MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-your-local-deepseek-key
DEEPSEEK_MODEL_ID=deepseek-v4-pro
DEEPSEEK_CHEAP_MODEL_ID=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=high

# Shared gateway controls.
MODEL_GATEWAY_MAX_CONCURRENT=4
MODEL_GATEWAY_TOKEN_BUDGET=200000

# Optional per-role overrides.
# PLANNER_MODEL_ID=deepseek-v4-pro
# CODER_MODEL_ID=deepseek-v4-pro
# TESTER_MODEL_ID=deepseek-v4-flash
# REVIEWER_MODEL_ID=deepseek-v4-pro
# SUMMARIZER_MODEL_ID=deepseek-v4-flash

# =============================================================================
# Anthropic-compatible fallback
# =============================================================================

# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-with-your-local-anthropic-key
# MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Other Anthropic-compatible providers can be configured by changing
# ANTHROPIC_BASE_URL and MODEL_ID. Keep real credentials only in local .env.
